│   ├── CaptureScheduler.swift
│   └── ImageDeduplication.swift
├── Monitoring/
│   ├── ApplicationMonitor.swift
│   ├── WindowMonitor.swift
│   ├── IdleMonitor.swift
│   └── SystemStateMonitor.swift
├── OCR/
│   └── VisionOCRService.swift
├── AI/
